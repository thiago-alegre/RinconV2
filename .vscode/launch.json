{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rincon https",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Rincon/bin/Debug/net8.0/Rincon.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Rincon",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "https://localhost:7109"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Rincon/Views"
      }
    }
  ]
}
