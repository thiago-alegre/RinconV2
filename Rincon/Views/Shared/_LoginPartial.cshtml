@using Microsoft.AspNetCore.Identity
@using Rincon.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = currentUser?.FullName ?? currentUser?.UserName ?? User.Identity?.Name ?? "Usuario";

        <li class="nav-item d-flex align-items-center me-3">
            <span class="nav-link fw-semibold d-flex align-items-center gap-2">
                @displayName
                <i class="bi bi-person-circle fs-5"></i>
            </span>
        </li>

        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Cart", new { area = "Employee" })"
                  method="post"
                  class="d-inline">

                <button id="logoutBtn"
                        type="submit"
                        class="btn btn-outline-danger btn-sm d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Salir</span>
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-outline-primary btn-sm"
               asp-area="Identity"
               asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>
                Iniciar sesión
            </a>
        </li>
    }
</ul>