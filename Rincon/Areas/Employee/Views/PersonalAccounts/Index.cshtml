@{
    ViewData["Title"] = "Cuentas personales";
    bool canManage = ViewBag.CanManage == true;
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-person-lines-fill"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Crédito interno</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">Cuentas personales</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Cómo usar cuentas personales",
                        Description = "Gestioná las ventas que quedan pendientes de pago para clientes con cuenta.",
        Items = new[]
        {
            "El listado muestra cuánto debe cada persona y desde cuándo.",
            "Ver detalle permite revisar ventas, artículos y pagos registrados.",
            "Los pagos parciales reducen la deuda pendiente; saldada aparece en verde."
        }
                    })
                </div>
                <p class="admin-subtitle mb-0">Consultá deudas, ventas asociadas y saldos pendientes.</p>
            </div>
        </div>

        @if (canManage)
        {
            <a asp-area="Employee" asp-controller="PersonalAccounts" asp-action="Upsert" class="btn btn-primary btn-modern">
                <i class="bi bi-plus-circle me-1"></i> Crear cuenta
            </a>
        }
    </div>

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Listado</span>
                <h2 class="section-title mb-0">Personas con cuenta</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="personalAccountsTable" class="table custom-table mb-0 w-100">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>DNI</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th>Debe</th>
                        <th>Desde</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/personalAccount.js" asp-append-version="true"></script>
}
