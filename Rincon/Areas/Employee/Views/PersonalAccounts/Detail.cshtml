@model Rincon.Models.ViewModels.PersonalAccountDetailVM

@{
    ViewData["Title"] = "Detalle de cuenta personal";
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-person-lines-fill"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Cuenta personal</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">@Model.Account.FullName</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Detalle de cuenta personal",
                        Description = "Revisá deuda, ventas asociadas y pagos registrados para esta persona.",
                        Items = new[] { "Registrar pago permite saldar total o parcialmente la deuda.", "Las ventas pendientes muestran artículos, fechas y valores.", "Los pagos quedan registrados para controlar cuándo y cuánto abonó." }
                    })
                </div>
                <p class="admin-subtitle mb-0">DNI @Model.Account.DNI · @(Model.Account.Phone ?? "Sin teléfono")</p>
            </div>
        </div>

        <a asp-area="Employee" asp-controller="PersonalAccounts" asp-action="Index" class="btn btn-soft-secondary">
            <i class="fa fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Deuda actual</div>
                <div class="detail-metric-value text-danger">$ @Model.CurrentDebt.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Adeuda desde</div>
                <div class="detail-metric-value">@(Model.DebtSince.HasValue ? Model.DebtSince.Value.ToString("dd/MM/yyyy") : "-")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Dirección</div>
                <div class="detail-metric-value">@(Model.Account.Address ?? "-")</div>
            </div>
        </div>
    </div>

    @if (Model.CurrentDebt > 0)
    {
        <div class="content-card mb-4">
            <form asp-area="Employee" asp-controller="PersonalAccounts" asp-action="Settle" method="post" class="personal-account-settle-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Account.Id" />
                <div>
                    <span class="section-kicker">Cobro</span>
                    <h2 class="section-title mb-0">Registrar pago de cuenta</h2>
                    <p class="text-muted mb-0">Si el monto queda vacío, se registra el total pendiente.</p>
                </div>
                <select name="PaymentMethod" class="form-select">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input name="AmountText"
                           class="form-control"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="Monto abonado" />
                </div>
                <input name="Notes" class="form-control" placeholder="Observación opcional" maxlength="500" />
                <button type="submit" class="btn btn-success btn-modern">
                    <i class="fa fa-check me-1"></i> Registrar pago
                </button>
            </form>
        </div>
    }

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Ventas</span>
                <h2 class="section-title mb-0">Artículos vendidos a esta cuenta</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="personalAccountSaleDetailsTable"
                   class="table custom-table mb-0 w-100"
                   data-account-id="@Model.Account.Id">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Subtotal</th>
                        <th>Estado</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>

    <div class="content-card mt-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Cobros</span>
                <h2 class="section-title mb-0">Pagos registrados</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="personalAccountPaymentsTable"
                   class="table custom-table mb-0 w-100"
                   data-account-id="@Model.Account.Id">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Medio</th>
                        <th>Monto</th>
                        <th>Caja</th>
                        <th>Usuario</th>
                        <th>Observación</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/personalAccountDetail.js" asp-append-version="true"></script>
}
