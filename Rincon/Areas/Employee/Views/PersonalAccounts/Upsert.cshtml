@model Rincon.Models.PersonalAccount

@{
    ViewData["Title"] = Model.Id == 0 ? "Crear cuenta personal" : "Editar cuenta personal";
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-person-vcard"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Administración</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">@ViewData["Title"]</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Formulario de cuenta personal",
                        Description = "Cargá los datos de la persona que podrá comprar a cuenta.",
                        Items = new[] { "Nombre completo y DNI ayudan a identificar correctamente la cuenta.", "Teléfono y dirección son datos de contacto para seguimiento.", "Solo administradores pueden crear, editar o eliminar cuentas." }
                    })
                </div>
                <p class="admin-subtitle mb-0">Datos de la persona habilitada para cuenta personal.</p>
            </div>
        </div>

        <a asp-area="Employee" asp-controller="PersonalAccounts" asp-action="Index" class="btn btn-soft-secondary">
            <i class="fa fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="Date" type="hidden" />

        <div class="content-card">
            <div asp-validation-summary="ModelOnly" class="alert custom-alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DNI" class="form-label"></label>
                    <input asp-for="DNI" class="form-control" autocomplete="off" />
                    <span asp-validation-for="DNI" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" autocomplete="street-address" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch custom-switch">
                        <input asp-for="isActive" class="form-check-input" type="checkbox" />
                        <label asp-for="isActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-area="Employee" asp-controller="PersonalAccounts" asp-action="Index" class="btn btn-soft-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-modern">
                    <i class="fa fa-save me-1"></i> Guardar
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
