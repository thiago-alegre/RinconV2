@model Rincon.Models.ViewModels.PersonalAccountDetailVM

@{
    ViewData["Title"] = "Detalle de cuenta personal";
}

<div class="admin-page py-4">
    <div class="admin-hero admin-hero-toolbar mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-person-lines-fill"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Cuenta personal</span>
                <h1 class="admin-title h3 mb-1">@Model.Account.FullName</h1>
                <p class="admin-subtitle mb-0">
                    DNI @Model.Account.DNI · @(Model.Account.Phone ?? "Sin teléfono")
                </p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-primary btn-modern">
            <i class="fa fa-arrow-left me-1"></i>
            Volver
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-5 g-3 mb-4">
        <div class="col">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Deuda actual</div>
                <div class="detail-metric-value text-danger">@Model.CurrentDebt.ToString("C")</div>
            </div>
        </div>
        <div class="col">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Saldo a favor</div>
                <div class="detail-metric-value text-success">@Model.CurrentCredit.ToString("C")</div>
            </div>
        </div>
        <div class="col">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Adeuda desde</div>
                <div class="detail-metric-value">
                    @(Model.DebtSince.HasValue ? Model.DebtSince.Value.ToString("dd/MM/yyyy") : "-")
                </div>
            </div>
        </div>
        <div class="col">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Dirección</div>
                <div class="detail-metric-value">@(Model.Account.Address ?? "-")</div>
            </div>
        </div>
        <div class="col">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Saldo inicial cargado</div>
                <div class="detail-metric-value">@Model.Account.OpeningBalance.ToString("C")</div>
            </div>
        </div>
    </div>

    @if (Model.CurrentCredit > 0)
    {
        <div class="alert alert-success">
            Esta cuenta tiene <strong>@Model.CurrentCredit.ToString("C") a favor</strong>. El importe se aplicará automáticamente a las próximas compras realizadas en cuenta personal.
        </div>
    }

    @if (Model.Account.OpeningBalance > 0)
    {
        <div class="alert alert-info">
            Esta cuenta comenzó con una deuda anterior de <strong>@Model.Account.OpeningBalance.ToString("C")</strong>, sin productos asociados. Los pagos se imputan primero a ese saldo.
        </div>
    }

    @if (Model.CurrentDebt > 0)
    {
        <div class="content-card mb-4">
            <form asp-action="Pay" method="post" class="personal-account-settle-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Account.Id" />
                <input type="hidden" name="OperationId" value="@Model.PaymentOperationId" />

                <div>
                    <span class="section-kicker">Cobro</span>
                    <h2 class="section-title mb-0">Registrar pago</h2>
                    <p class="text-muted mb-0">Dejá el monto vacío para cancelar toda la deuda.</p>
                </div>

                <select name="PaymentMethod" class="form-select" aria-label="Medio de pago">
                    <option value="1">Efectivo</option>
                    <option value="2">Transferencia</option>
                </select>

                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input name="AmountText"
                           class="form-control"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="Monto abonado" />
                </div>

                <input name="Notes"
                       class="form-control"
                       maxlength="500"
                       placeholder="Observación opcional" />

                <button type="submit" class="btn btn-success btn-modern">
                    <i class="fa fa-check me-1"></i>
                    Registrar pago
                </button>
            </form>
        </div>
    }

    <div class="content-card">
        <div class="mb-3">
            <span class="section-kicker">Ventas</span>
            <h2 class="section-title mb-0">Productos asignados a esta cuenta</h2>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="accountSaleDetailsTable"
                   class="table custom-table mb-0 w-100"
                   data-account-id="@Model.Account.Id">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Subtotal</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>

    <div class="content-card mt-4">
        <div class="mb-3">
            <span class="section-kicker">Anulaciones</span>
            <h2 class="section-title mb-0">Anulaciones registradas</h2>
        </div>
        <div class="table-responsive custom-table-wrapper">
            <table id="accountCancellationsTable" class="table custom-table mb-0 w-100" data-account-id="@Model.Account.Id">
                <thead><tr><th>Fecha</th><th>Venta</th><th>Productos</th><th>Reintegro</th><th>Monto</th><th>Usuario</th><th>Motivo</th></tr></thead>
            </table>
        </div>
    </div>

    <div class="content-card mt-4">
        <div class="mb-3">
            <span class="section-kicker">Cobros</span>
            <h2 class="section-title mb-0">Pagos registrados</h2>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="accountPaymentsTable"
                   class="table custom-table mb-0 w-100"
                   data-account-id="@Model.Account.Id">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Medio</th>
                        <th>Monto</th>
                        <th>Usuario</th>
                        <th>Observación</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/accountDetail.js" asp-append-version="true"></script>
}
