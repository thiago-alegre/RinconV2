@model Rincon.Models.CashRegisterSession
@using Rincon.Models.ViewModels

@{
    ViewData["Title"] = $"Detalle de caja #{Model.Id}";
    var summary = ViewBag.Summary as CashRegisterSummaryVM ?? new CashRegisterSummaryVM();
    var userName = Model.User != null
        ? (!string.IsNullOrWhiteSpace(Model.User.FullName) ? Model.User.FullName : Model.User.Email ?? "Sin usuario")
        : "Sin usuario";
    var countedCash = Model.CountedCashAmount ?? 0;
    var difference = Model.Difference ?? countedCash - summary.ExpectedCash;
    var differenceClass = difference > 0
        ? "text-success"
        : difference < 0
            ? "text-danger"
            : "";
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Caja #@Model.Id</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">Detalle de caja</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Detalle de caja",
                        Description = "Consulta las ventas y productos registrados durante esta caja.",
        Items = new[]
        {
            "El resumen superior muestra los importes principales y la cantidad de ventas del turno.",
            "El desglose separa ventas, cobros, anulaciones y recambios.",
            "La tabla inferior permite ubicar productos, medios de pago y cuentas personales."
        }
                    })
                </div>
                <p class="admin-subtitle mb-0">
                    @userName - Apertura @Model.OpenedAt.ToString("dd/MM/yyyy HH:mm")
                    @if (Model.ClosedAt.HasValue)
                    {
                        <span> - Cierre @Model.ClosedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </p>
            </div>
        </div>

        <a asp-area="Employee" asp-controller="CashRegister" asp-action="Index" class="btn btn-soft-secondary">
            <i class="fa fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="cash-overview cash-overview-detail mb-4">
        <div class="cash-summary-card cash-summary-card-primary">
            <span>Total vendido</span>
            <strong>$ @summary.TotalSales.ToString("N2")</strong>
        </div>
        <div class="cash-summary-card">
            <span>Ventas del turno</span>
            <strong>@summary.SalesCount</strong>
        </div>
        <div class="cash-summary-card">
            <span>Efectivo esperado</span>
            <strong>$ @summary.ExpectedCash.ToString("N2")</strong>
        </div>
        <div class="cash-summary-card">
            <span>Efectivo contado</span>
            <strong>$ @countedCash.ToString("N2")</strong>
        </div>
        <div class="cash-summary-card">
            <span>Diferencia</span>
            <strong class="@differenceClass">$ @difference.ToString("N2")</strong>
        </div>
    </div>

    <div class="content-card mb-4">
        <div class="mb-3">
            <span class="section-kicker">Desglose</span>
            <h2 class="section-title mb-0">Movimientos del turno</h2>
        </div>

        <div class="cash-breakdown-grid cash-breakdown-grid-detail">
            <div class="cash-breakdown-item">
                <span>Monto inicial</span>
                <strong>$ @Model.OpeningAmount.ToString("N2")</strong>
            </div>
            <div class="cash-breakdown-item">
                <span>Efectivo vendido</span>
                <strong>$ @summary.CashSales.ToString("N2")</strong>
            </div>
            <div class="cash-breakdown-item">
                <span>Transferencia vendida</span>
                <strong>$ @summary.TransferSales.ToString("N2")</strong>
            </div>
            <div class="cash-breakdown-item">
                <span>Cuenta personal</span>
                <strong>$ @summary.PersonalAccountSales.ToString("N2")</strong>
            </div>
            <div class="cash-breakdown-item">
                <span>Cobros cuenta personal</span>
                <strong>$ @summary.PersonalAccountCashPayments.ToString("N2")</strong>
                <small>Transferencia: $ @summary.PersonalAccountTransferPayments.ToString("N2")</small>
            </div>
            <div class="cash-breakdown-item">
                <span>Anulaciones</span>
                <strong class="text-danger">-$ @summary.TotalReturns.ToString("N2")</strong>
                <small>@summary.ReturnsCount movimientos</small>
            </div>
            <div class="cash-breakdown-item">
                <span>Recambios</span>
                <strong class="text-danger">-$ @summary.ExchangeLoss.ToString("N2")</strong>
                <small>@summary.ExchangesCount movimientos</small>
            </div>
            <div class="cash-breakdown-item">
                <span>Estado</span>
                <strong>
                    <span class="status-badge @(Model.IsOpen ? "status-active" : "expiration-danger")">
                        @(Model.IsOpen ? "ABIERTA" : "CERRADA")
                    </span>
                </strong>
                <small>@(Model.IsOpen ? "Caja en curso" : "Caja finalizada")</small>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Historial</span>
                <h2 class="section-title mb-0">Productos vendidos en esta caja</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="cashRegisterDetailTable" class="table custom-table mb-0 w-100" data-session-id="@Model.Id">
                <thead>
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Venta</th>
                        <th>Movimiento</th>
                        <th>Medio de pago</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio unitario</th>
                        <th>Subtotal</th>
                        <th>Cuenta personal</th>
                        <th>Estado deuda</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cashRegisterDetail.js" asp-append-version="true"></script>
}
