@model Rincon.Models.ViewModels.CashRegisterVM

@{
    ViewData["Title"] = "Caja";

    string GetUserName(Rincon.Models.CashRegisterSession session)
    {
        return session.User != null
            ? (!string.IsNullOrWhiteSpace(session.User.FullName) ? session.User.FullName : session.User.Email ?? "Sin usuario")
            : "Sin usuario";
    }
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Turno</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">Caja</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Cómo usar caja",
                        Description = "La caja permite controlar el dinero y las ventas de cada turno.",
        Items = new[]
        {
            "Abrí caja al comenzar el turno ingresando el efectivo inicial.",
            "Las ventas confirmadas se suman automáticamente a la caja abierta.",
            "Al cerrar, ingresá el efectivo contado para comparar contra lo esperado.",
            "Podés tener varios cierres en un mismo día, uno por cada turno."
        }
                    })
                </div>
                <p class="admin-subtitle mb-0">Abrí y cerrá la caja del turno para controlar el efectivo real.</p>
            </div>
        </div>
    </div>

    @if (Model.OpenSession == null)
    {
        <div class="content-card mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <span class="section-kicker">Apertura</span>
                    <h2 class="section-title mb-1">No hay caja abierta</h2>
                    <p class="text-muted mb-0">Ingresá el efectivo inicial para comenzar a vender en este turno.</p>
                </div>

                <form asp-area="Employee" asp-controller="CashRegister" asp-action="Open" method="post" class="cash-inline-form">
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input name="OpeningAmountText" class="form-control" placeholder="Efectivo inicial" autocomplete="off" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-modern">
                        <i class="bi bi-unlock me-1"></i> Abrir caja
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="cash-overview mb-4">
            <div class="cash-summary-card cash-summary-card-primary">
                <span>Total vendido</span>
                <strong>$ @Model.CurrentSummary.TotalSales.ToString("N2")</strong>
            </div>
            <div class="cash-summary-card">
                <span>Efectivo esperado</span>
                <strong>$ @Model.CurrentSummary.ExpectedCash.ToString("N2")</strong>
            </div>
            <div class="cash-summary-card">
                <span>Ventas del turno</span>
                <strong>@Model.CurrentSummary.SalesCount</strong>
            </div>
            <div class="cash-summary-card">
                <span>Monto inicial</span>
                <strong>$ @Model.OpenSession.OpeningAmount.ToString("N2")</strong>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-xl-8">
                <div class="content-card h-100">
                    <div class="mb-3">
                        <span class="section-kicker">Desglose</span>
                        <h2 class="section-title mb-0">Movimientos del turno</h2>
                    </div>

                    <div class="cash-breakdown-grid">
                        <div class="cash-breakdown-item">
                            <span>Efectivo vendido</span>
                            <strong>$ @Model.CurrentSummary.CashSales.ToString("N2")</strong>
                        </div>
                        <div class="cash-breakdown-item">
                            <span>Transferencia vendida</span>
                            <strong>$ @Model.CurrentSummary.TransferSales.ToString("N2")</strong>
                        </div>
                        <div class="cash-breakdown-item">
                            <span>Cuenta personal</span>
                            <strong>$ @Model.CurrentSummary.PersonalAccountSales.ToString("N2")</strong>
                        </div>
                        <div class="cash-breakdown-item">
                            <span>Cobros cuenta personal</span>
                            <strong>$ @Model.CurrentSummary.PersonalAccountCashPayments.ToString("N2")</strong>
                            <small>Transferencia: $ @Model.CurrentSummary.PersonalAccountTransferPayments.ToString("N2")</small>
                        </div>
                        <div class="cash-breakdown-item">
                            <span>Anulaciones</span>
                            <strong class="text-danger">-$ @Model.CurrentSummary.TotalReturns.ToString("N2")</strong>
                            <small>@Model.CurrentSummary.ReturnsCount movimientos</small>
                        </div>
                        <div class="cash-breakdown-item">
                            <span>Recambios</span>
                            <strong class="text-danger">-$ @Model.CurrentSummary.ExchangeLoss.ToString("N2")</strong>
                            <small>@Model.CurrentSummary.ExchangesCount movimientos</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="content-card h-100">
                    <span class="section-kicker">Caja abierta</span>
                    <h2 class="section-title mb-1">@GetUserName(Model.OpenSession)</h2>
                    <p class="text-muted mb-3">Abierta el @Model.OpenSession.OpenedAt.ToString("dd/MM/yyyy HH:mm")</p>

                    <form asp-area="Employee" asp-controller="CashRegister" asp-action="Close" method="post" class="cash-close-form cash-close-form-stacked">
                        <input type="hidden" name="Id" value="@Model.OpenSession.Id" />
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input name="CountedCashAmountText" class="form-control" placeholder="Efectivo contado" autocomplete="off" />
                        </div>
                        <input name="Notes" class="form-control" placeholder="Observación opcional" maxlength="500" />
                        <button type="submit" class="btn btn-danger btn-modern w-100">
                            <i class="bi bi-lock me-1"></i> Cerrar caja
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Historial</span>
                <h2 class="section-title mb-0">Cajas recientes</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="cashRegisterTable" class="table custom-table mb-0 w-100">
                <thead>
                    <tr>
                        <th>Caja</th>
                        <th>Usuario</th>
                        <th>Apertura</th>
                        <th>Cierre</th>
                        <th>Monto inicial</th>
                        <th>Efectivo esperado</th>
                        <th>Efectivo contado</th>
                        <th>Diferencia</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cashRegister.js" asp-append-version="true"></script>
}
