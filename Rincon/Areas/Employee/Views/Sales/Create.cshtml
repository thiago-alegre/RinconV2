@model Rincon.Models.ViewModels.DirectSaleCreateVM
@using Rincon.Utilities.Enums

@{
    ViewData["Title"] = "Registrar venta";
    var combinedPaymentError = ViewData.ModelState["CombinedPayment"]?
        .Errors
        .FirstOrDefault()?
        .ErrorMessage;
}

<form method="post" class="sale-create-form">
    <input type="hidden" asp-for="OperationId" />
    <div class="admin-page py-4">
        <div class="admin-hero mb-4">
            <span class="admin-eyebrow">Ventas</span>
            <h1 class="admin-title h3 mb-1">Registrar venta</h1>
            <p class="admin-subtitle mb-0">
                Agregá los productos y confirmá la operación directamente.
            </p>
        </div>

        <div class="form-card sale-form-card">
            <div class="sale-form-content">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="sale-meta-grid">
                    <div class="sale-field">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               type="datetime-local"
                               class="form-control" />
                    </div>

                    <div class="sale-field sale-payment-method-field">
                        <label asp-for="PaymentMethod" class="form-label"></label>
                        <select asp-for="PaymentMethod" id="payment" class="form-select">
                            <option value="@((int)PaymentMethod.Efectivo)">Efectivo</option>
                            <option value="@((int)PaymentMethod.Transferencia)">Transferencia</option>
                            <option value="@((int)PaymentMethod.CuentaPersonal)">Cuenta personal</option>
                            <option value="@((int)PaymentMethod.Combinado)">Combinado</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>

                    <div class="sale-field sale-payment-detail" id="accountBox">
                        <label asp-for="PersonalAccountId" class="form-label"></label>
                        <select asp-for="PersonalAccountId"
                                id="personalAccount"
                                class="form-select account-search"
                                style="width: 100%;">
                            <option value=""></option>
                            @foreach (var account in Model.Accounts)
                            {
                                <option value="@account.Id">@account.FullName — DNI @account.DNI</option>
                            }
                        </select>
                        <span asp-validation-for="PersonalAccountId" class="text-danger"></span>
                    </div>

                    <div id="combinedPaymentFields" class="sale-combined-payment-fields sale-payment-detail">
                        <div class="sale-field">
                            <label asp-for="CashAmount" class="form-label">Efectivo</label>
                            <input asp-for="CashAmount"
                                   id="cashAmount"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   data-val="false"
                                   value="@(Model.CashAmount == 0 ? string.Empty : Model.CashAmount.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture))"
                                   class="form-control"
                                   placeholder="0,00" />
                        </div>

                        <div class="sale-field">
                            <label asp-for="TransferAmount" class="form-label">Transferencia</label>
                            <input asp-for="TransferAmount"
                                   id="transferAmount"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   data-val="false"
                                   value="@(Model.TransferAmount == 0 ? string.Empty : Model.TransferAmount.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture))"
                                   class="form-control"
                                   placeholder="0,00" />
                        </div>

                        <div id="combinedPaymentFeedback"
                             class="sale-combined-payment-feedback"
                             role="status"
                             aria-live="polite">@combinedPaymentError</div>
                    </div>
                </div>

                <div class="sale-lines-header" aria-hidden="true">
                    <span>Producto o descripción</span>
                    <span>Cantidad</span>
                    <span></span>
                </div>

                <div id="lines">
                    @for (var index = 0; index < Model.Lines.Count; index++)
                    {
                        var line = Model.Lines[index];
                        <div class="sale-line @(line.IsLoose ? "sale-line-loose" : "sale-line-registered")">
                            <input name="Lines[@index].IsLoose" type="hidden" value="@(line.IsLoose ? "true" : "false")" class="line-is-loose" />
                            @if (line.IsLoose)
                            {
                                <div class="sale-product-field">
                                    <input name="Lines[@index].LooseName"
                                           value="@line.LooseName"
                                           maxlength="200"
                                           autocomplete="off"
                                           class="form-control loose-name"
                                           aria-label="Descripción del producto suelto"
                                           placeholder="Descripción, por ejemplo: Chicle" />
                                </div>
                                <div class="sale-price-field">
                                    <input name="Lines[@index].LooseUnitPrice"
                                           value="@(line.LooseUnitPrice == 0 ? string.Empty : line.LooseUnitPrice.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture))"
                                           type="text"
                                           inputmode="decimal"
                                           autocomplete="off"
                                           class="form-control loose-price"
                                           aria-label="Precio unitario"
                                           placeholder="Precio" />
                                </div>
                            }
                            else
                            {
                                <div class="sale-product-field">
                                    <select name="Lines[@index].ProductId" class="form-select product product-search" style="width: 100%;">
                                        <option value="">Seleccione un producto...</option>
                                        @foreach (var product in Model.Products)
                                        {
                                            <option value="@product.Id"
                                                    data-price="@product.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                    selected="@(line.ProductId == product.Id ? "selected" : null)">
                                                @product.Name — @product.SalePrice.ToString("C") · Stock @product.Quantity
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="sale-quantity-field">
                                <input name="Lines[@index].Quantity"
                                       value="@line.Quantity"
                                       type="number"
                                       min="1"
                                       step="1"
                                       inputmode="numeric"
                                       aria-label="Cantidad"
                                       class="form-control quantity" />
                            </div>

                            <div class="sale-remove-action">
                                <button type="button" class="btn btn-outline-danger remove sale-remove-button">
                                    Quitar
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" id="addLine" class="btn btn-outline-primary sale-add-button">
                        <i class="bi bi-plus"></i> Agregar producto
                    </button>
                    <button type="button" id="addLooseLine" class="btn btn-outline-primary sale-add-button">
                        <i class="bi bi-plus-circle"></i> Agregar suelto
                    </button>
                </div>

                <template id="looseLineTemplate">
                    <div class="sale-line sale-line-loose">
                        <input name="Lines[__index__].IsLoose" type="hidden" value="true" class="line-is-loose" />
                        <div class="sale-product-field">
                            <input name="Lines[__index__].LooseName" maxlength="200" autocomplete="off"
                                   class="form-control loose-name" aria-label="Descripción del producto suelto"
                                   placeholder="Descripción, por ejemplo: Chicle" />
                        </div>
                        <div class="sale-price-field">
                            <input name="Lines[__index__].LooseUnitPrice" type="text" inputmode="decimal" autocomplete="off"
                                   class="form-control loose-price" aria-label="Precio unitario" placeholder="Precio" />
                        </div>
                        <div class="sale-quantity-field">
                            <input name="Lines[__index__].Quantity" value="1" type="number" min="1" step="1"
                                   inputmode="numeric" aria-label="Cantidad" class="form-control quantity" />
                        </div>
                        <div class="sale-remove-action">
                            <button type="button" class="btn btn-outline-danger remove sale-remove-button">Quitar</button>
                        </div>
                    </div>
                </template>

                <div class="sale-total-row">
                    <strong>Total estimado</strong>
                    <span id="total" class="h3">$ 0,00</span>
                </div>

                <div class="sale-form-actions">
                    <a asp-controller="Balance"
                       asp-action="Index"
                       class="btn btn-soft-secondary sale-action-button">
                        Cancelar
                    </a>
                    <button class="btn btn-primary sale-action-button">Confirmar venta</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/salesCreate.js" asp-append-version="true"></script>
}
