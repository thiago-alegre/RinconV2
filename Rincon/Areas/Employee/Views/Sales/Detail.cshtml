@model Rincon.Models.DirectSale
@using Rincon.Utilities.Enums
@using Rincon.Utilities

@{
    ViewData["Title"] = $"Venta #{Model.Id}";
    var profit = Model.Total - Model.TotalCost;
    var returnedTotal = Model.Returns.Sum(item => item.Total);
    var returnedCost = Model.Returns.Sum(item => item.TotalCost);
    var netTotal = Model.Total - returnedTotal;
    var netProfit = profit - (returnedTotal - returnedCost);
    var fullyReturned = returnedTotal >= Model.Total;
    var seller = string.IsNullOrWhiteSpace(Model.User?.FullName)
        ? Model.User?.Email ?? "Sin usuario"
        : Model.User.FullName;
}

<div class="admin-page py-4">
    <div class="admin-hero admin-hero-toolbar mb-4">
        <div>
            <span class="admin-eyebrow">Detalle de venta</span>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="admin-title h3 mb-0">Venta #@Model.Id</h1>
                <span class="status-badge @(fullyReturned ? "status-inactive" : returnedTotal > 0 ? "status-warning" : "status-active")">
                    @(fullyReturned ? "Anulada" : returnedTotal > 0 ? "Anulación parcial" : "Vigente")
                </span>
            </div>
            <p class="admin-subtitle mb-0 mt-1">Registrada el @Model.Date.ToString("dd/MM/yyyy 'a las' HH:mm").</p>
        </div>

        <div class="admin-hero-actions">
            <a asp-action="Index" class="btn btn-soft-secondary btn-modern">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>

            @if (!fullyReturned)
            {
                <a asp-action="Void" asp-route-id="@Model.Id" class="btn btn-primary btn-modern">
                    <i class="bi bi-x-circle me-1"></i> Anular venta
                </a>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Total</div>
                <div class="detail-metric-value success">@netTotal.ToString("C")</div>
                @if (returnedTotal > 0) { <small class="text-muted">Original @Model.Total.ToString("C")</small> }
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Costo registrado</div>
                <div class="detail-metric-value">@((Model.TotalCost - returnedCost).ToString("C"))</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Utilidad estimada</div>
                <div class="detail-metric-value">@netProfit.ToString("C")</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Forma de pago</div>
                <div class="detail-metric-value">@DisplayFormatting.PaymentMethodName(Model.PaymentMethod)</div>
            </div>
        </div>
    </div>

    @if (Model.Returns.Any())
    {
        <div class="content-card mb-4">
            <span class="section-kicker">Anulaciones</span>
            <h2 class="section-title">Productos anulados</h2>
            @foreach (var saleReturn in Model.Returns.OrderByDescending(item => item.Date))
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                        <strong>Anulación #@saleReturn.Id · @saleReturn.Date.ToString("dd/MM/yyyy HH:mm")</strong>
                        <strong class="text-danger">-@saleReturn.Total.ToString("C")</strong>
                    </div>
                    <div class="text-muted mb-2">@(saleReturn.Reason ?? "Sin motivo") · @(saleReturn.User?.FullName ?? "Sin usuario")</div>
                    <ul class="mb-2">
                        @foreach (var item in saleReturn.Items)
                        {
                            <li>@item.ProductName × @DisplayFormatting.Quantity(item.Quantity) @(item.ReturnsToStock ? "· repuesto en stock" : "· no vuelve al stock")</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }

    <div class="content-card mb-4">
        <div class="sale-detail-meta">
            <div>
                <span>Registró</span>
                <strong>@seller</strong>
            </div>
            <div>
                @if (Model.PaymentMethod == PaymentMethod.Combinado)
                {
                    <span>Distribución del pago</span>
                    <strong>Efectivo @Model.CashAmount.ToString("C") · Transferencia @Model.TransferAmount.ToString("C")</strong>
                }
                else
                {
                    <span>Cuenta personal</span>
                    <strong>@(Model.PersonalAccount?.FullName ?? "No corresponde")</strong>
                }
            </div>
            <div>
                <span>Cantidad de productos</span>
                <strong>@Model.Items.Sum(item => item.Quantity).ToString("N0")</strong>
            </div>
        </div>
    </div>

    <div class="content-card mb-4">
        <div class="mb-3">
            <span class="section-kicker">Productos</span>
            <h2 class="section-title mb-0">Detalle de la operación</h2>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Anulada</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end">Costo unitario</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items.OrderBy(item => item.Id))
                    {
                        <tr>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="text-end">@DisplayFormatting.Quantity(item.Quantity)</td>
                            <td class="text-end">@DisplayFormatting.Quantity(item.ReturnItems.Sum(value => value.Quantity))</td>
                            <td class="text-end">@item.UnitPrice.ToString("C")</td>
                            <td class="text-end">@item.UnitCost.ToString("C")</td>
                            <td class="text-end fw-bold">@item.Subtotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
