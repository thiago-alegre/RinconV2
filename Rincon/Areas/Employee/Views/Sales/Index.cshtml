@{
    ViewData["Title"] = "Ventas";
    var dateFrom = (DateTime)ViewBag.DateFrom;
    var dateTo = (DateTime)ViewBag.DateTo;
    var status = (string)ViewBag.Status;
}

<div class="admin-page py-4">
    <div class="admin-hero admin-hero-toolbar mb-4">
        <div>
            <span class="admin-eyebrow">Seguimiento comercial</span>
            <h1 class="admin-title h3 mb-1">Ventas</h1>
            <p class="admin-subtitle mb-0">Consultá las operaciones, sus productos y el estado de cada venta.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary btn-modern">
            <i class="bi bi-plus-circle me-1"></i> Registrar venta
        </a>
    </div>

    <div class="content-card mb-4">
        <form id="salesPeriodForm" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="salesDateFrom" class="form-label">Desde</label>
                <input id="salesDateFrom"
                       type="date"
                       name="dateFrom"
                       value="@dateFrom.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label for="salesDateTo" class="form-label">Hasta</label>
                <input id="salesDateTo"
                       type="date"
                       name="dateTo"
                       value="@dateTo.ToString("yyyy-MM-dd")"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label for="salesStatus" class="form-label">Estado</label>
                <select id="salesStatus" name="status" class="form-select">
                    <option value="all" selected="@(status == "all")">Todas</option>
                    <option value="active" selected="@(status == "active")">Vigentes</option>
                    <option value="voided" selected="@(status == "voided")">Anuladas</option>
                </select>
            </div>

            <div class="col-md-3">
                <button class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Aplicar filtros
                </button>
            </div>
        </form>
    </div>

    <div class="content-card">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <div>
                <span class="section-kicker">Histórico</span>
                <h2 class="section-title mb-0">Ventas registradas</h2>
            </div>
        </div>

        <div class="table-responsive">
            <table id="salesTable" class="table custom-table align-middle mb-0 w-100">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>N.º</th>
                        <th>Productos</th>
                        <th>Forma de pago</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Utilidad</th>
                        <th>Registró</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/salesHistory.js" asp-append-version="true"></script>
}
