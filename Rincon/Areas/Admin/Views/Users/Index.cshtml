@{
    ViewData["Title"] = "Usuarios";
}

<div class="admin-page py-4">
    <div class="admin-hero admin-hero-toolbar mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="fa fa-users"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Administración</span>
                <h1 class="admin-title h3 mb-1">Usuarios</h1>
                <p class="admin-subtitle mb-0">Gestioná empleados, administradores y accesos al sistema.</p>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Users" asp-action="Upsert" class="btn btn-primary btn-modern">
            <i class="fa fa-user-plus me-1"></i> Crear usuario
        </a>
    </div>

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Listado</span>
                <h2 class="section-title mb-0">Lista de usuarios</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="usersTable" class="table custom-table mb-0 w-100">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>DNI</th>
                        <th>Teléfono</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/user.js" asp-append-version="true"></script>
}
