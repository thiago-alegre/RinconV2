@model Rincon.Models.ViewModels.UserVM

@{
    ViewData["Title"] = Model.Id == null ? "Crear usuario" : "Editar usuario";
}

<div class="admin-page py-4">
    <div class="admin-hero admin-hero-toolbar mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="fa fa-user-gear"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Usuarios</span>
                <h1 class="admin-title h3 mb-1">@(Model.Id == null ? "Crear usuario" : "Editar usuario")</h1>
                <p class="admin-subtitle mb-0">
                    @(Model.Id == null ? "Registrá un nuevo usuario para operar el sistema." : "Actualizá los datos y permisos del usuario.")
                </p>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-soft-secondary">
            <i class="fa fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="form-card">
        <div class="mb-4">
            <span class="section-kicker">Datos principales</span>
            <h2 class="section-title mb-0">Información del usuario</h2>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Ej: Juan Pérez" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" placeholder="usuario@email.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="DNI" class="form-label fw-semibold"></label>
                    <input asp-for="DNI" class="form-control" placeholder="Solo números" autocomplete="off" inputmode="numeric" pattern="[0-9]*" />
                    <span asp-validation-for="DNI" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Teléfono" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Role" class="form-label fw-semibold"></label>
                    <select asp-for="Role" asp-items="Model.RoleList" class="form-select" autocomplete="off">
                        <option disabled selected value="">Seleccionar rol</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label fw-semibold"></label>
                    <input asp-for="Address" class="form-control" placeholder="Dirección" autocomplete="street-address" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
            </div>

            @if (Model.Id == null)
            {
                <div class="custom-alert-info mt-4 mb-0">
                    <i class="fa fa-circle-info me-1"></i>
                    Elegí una contraseña inicial y compartila con el usuario por un canal privado.
                    <label asp-for="NewPassword" class="form-label">Contraseña inicial</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="mt-4">
                    <span class="section-kicker">Acceso</span>
                    <h2 class="section-title mb-2">Cambiar contraseña</h2>

                    @if (!Model.CanChangePassword)
                    {
                        <div class="custom-alert-info mb-0">
                            <i class="fa fa-shield-halved me-1"></i>
                            @Model.PasswordProtectionMessage
                        </div>
                    }
                    else
                    {
                        <div class="custom-alert-info mb-3">
                            <i class="fa fa-circle-info me-1"></i>
                            Completá estos campos solo si querés cambiar la contraseña del usuario.
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="NewPassword"
                                           class="form-control password-toggle-input"
                                           autocomplete="new-password" />
                                    <button type="button"
                                            class="btn btn-outline-secondary password-toggle-btn"
                                            data-password-target="NewPassword"
                                            aria-label="Mostrar u ocultar contraseña">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="ConfirmPassword"
                                           class="form-control password-toggle-input"
                                           autocomplete="new-password" />
                                    <button type="button"
                                            class="btn btn-outline-secondary password-toggle-btn"
                                            data-password-target="ConfirmPassword"
                                            aria-label="Mostrar u ocultar contraseña">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-soft-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary btn-modern">
                    <i class="fa fa-save me-1"></i> Guardar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll(".password-toggle-btn").forEach((button) => {
            button.addEventListener("click", () => {
                const input = document.getElementById(button.dataset.passwordTarget);
                const icon = button.querySelector("i");

                if (!input || !icon) {
                    return;
                }

                const shouldShow = input.type === "password";
                input.type = shouldShow ? "text" : "password";
                icon.classList.toggle("fa-eye", !shouldShow);
                icon.classList.toggle("fa-eye-slash", shouldShow);
            });
        });
    </script>
}
