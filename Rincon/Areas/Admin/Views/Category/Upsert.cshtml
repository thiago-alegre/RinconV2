@model Rincon.Models.Category

@{
    ViewData["Title"] = Model.Id == 0 ? "Crear Categoría" : "Editar Categoría";
}

<form method="post" asp-action="Upsert">
    <input asp-for="Id" hidden />
    <input asp-for="Date" hidden />

    <div class="admin-page py-4">
        <div class="admin-hero mb-4 d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="fa fa-folder-open"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Categorías</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">
                        @(Model.Id == 0 ? "Crear categoría" : "Editar categoría")
                    </h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Formulario de categoría",
                        Description = "Usá este formulario para crear o modificar un grupo de productos.",
        Items = new[]
        {
            "El nombre debe ser claro porque se verá en artículos, búsquedas y estadísticas.",
            "El switch Activo/Inactivo controla si la categoría queda disponible.",
            "Volver cancela la edición sin guardar cambios."
        }
                    })
                </div>
                <p class="admin-subtitle mb-0">Definí el nombre y el estado disponible para organizar productos.</p>
            </div>
        </div>

        <div class="form-card">
            <div class="mb-4">
                <span class="section-kicker">Datos principales</span>
                <h2 class="section-title mb-0">Información de la categoría</h2>
            </div>

            <div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Ingrese el nombre de la categoría" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="form-label">Estado</div>

                    <div class="form-check form-switch">
                        <input asp-for="isActive"
                               class="form-check-input admin-switch"
                               type="checkbox"
                               role="switch"
                               id="isActiveSwitch" />

                        <label class="form-check-label fw-bold admin-switch-label" id="isActiveLabel" for="isActiveSwitch">
                            @(Model.isActive ? "Activo" : "Inactivo")
                        </label>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <button type="submit" class="btn btn-primary btn-modern w-100">
                            @(Model.Id == 0 ? "Crear" : "Actualizar")
                        </button>
                    </div>
                    <div class="col-6">
                        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-soft-secondary w-100">
                            Volver
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const switchInput = document.getElementById("isActiveSwitch");
            const switchLabel = document.getElementById("isActiveLabel");

            function updateSwitchLabel() {
                if (switchInput.checked) {
                    switchLabel.textContent = "Activo";
                    switchLabel.classList.remove("text-danger");
                    switchLabel.classList.add("text-success");
                } else {
                    switchLabel.textContent = "Inactivo";
                    switchLabel.classList.remove("text-success");
                    switchLabel.classList.add("text-danger");
                }
            }

            updateSwitchLabel();

            switchInput.addEventListener("change", updateSwitchLabel);
        });
    </script>
}
