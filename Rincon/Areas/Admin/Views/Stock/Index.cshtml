@{
    ViewData["Title"] = "Lotes";
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-boxes"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Administración</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">Lotes</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Cómo usar lotes",
                        Description = "Revisá los artículos que trabajan con stock por lotes y entrá al detalle de cada uno.",
        Items = new[]
        {
            "Cada fila representa un producto agrupado, no un lote individual.",
            "Buscá un producto desde el encabezado para abrir su detalle y cargar un lote nuevo.",
            "Dentro del detalle vas a ver cada lote, su cantidad, costo y vencimiento."
        }
                    })
                </div>
                <p class="admin-subtitle mb-0">Gestioná productos con lotes, stock disponible y vencimientos próximos.</p>
            </div>
        </div>

        <div class="batch-hero-search">
            <label class="stats-filter-label mb-1" for="batchArticleSearch">Crear o gestionar lote</label>
            <div class="batch-hero-search-row">
                <select id="batchArticleSearch"
                        class="form-select"
                        data-placeholder="Buscá artículo por nombre, código o categoría"></select>
                <button type="button" id="goToBatchArticle" class="btn btn-primary btn-modern" disabled>
                    <i class="bi bi-boxes me-1"></i> Ir
                </button>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Gestión</span>
                <h2 class="section-title mb-0">Productos con lotes</h2>
            </div>
        </div>

        <div class="custom-table-wrapper">
            <table id="stockAdvancedTable" class="table custom-table mb-0 w-100">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Stock en lotes</th>
                        <th>Stock mínimo</th>
                        <th>Lotes activos</th>
                        <th>Vencimiento más próximo</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/stockAdvanced.js" asp-append-version="true"></script>
}
