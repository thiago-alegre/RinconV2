@model Rincon.Models.ArticleBatch

@{
    ViewData["Title"] = Model.Id == 0 ? "Cargar stock" : "Editar lote";
    var article = ViewBag.Article as Rincon.Models.Article;
    var isNew = Model.Id == 0;
    var unitLabel = article?.IsSoldByWeight == true ? "kg" : "unidades";
    var costSuffix = article?.IsSoldByWeight == true ? "por kg" : "por unidad";
}

<form method="post" asp-action="Upsert">
    <input asp-for="Id" hidden />
    <input asp-for="ArticleId" hidden />
    <input asp-for="CreatedAt" hidden />

    <div class="admin-page py-4">
        <div class="admin-hero mb-4 d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="bi bi-boxes"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Lotes</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">@(isNew ? "Cargar stock" : "Editar lote")</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Formulario de lote",
                        Description = "Usá esta pantalla para registrar una entrada de mercadería o ajustar un lote existente.",
        Items = new[]
        {
            "En lote nuevo, cantidad que ingresa se guarda como cantidad inicial y disponible.",
            "El costo de compra se toma como base para calcular la ganancia.",
            "La fecha de vencimiento es opcional, pero ayuda a vender primero lo que vence antes."
        }
                    })
                </div>
                <p class="admin-subtitle mb-0">@article?.Name</p>
            </div>
        </div>

        <div class="form-card">
            <div class="mb-4">
                <span class="section-kicker">Stock</span>
                <h2 class="section-title mb-1">@(isNew ? "Ingreso de mercadería" : "Información del lote")</h2>
                <p class="text-muted mb-0">
                    @(isNew
                        ? "Cargá la cantidad que entra al local. El sistema la suma al stock del artículo y la usa para controlar vencimiento y costo."
                        : "Ajustá los datos del lote. La cantidad disponible es lo que todavía queda para vender.")
                </p>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="quantityText">@(isNew ? $"Cantidad que ingresa ({unitLabel})" : $"Cantidad disponible ({unitLabel})")</label>
                    <input id="quantityText" name="quantityText" class="form-control" value="@Model.Quantity.ToString("#,##0.###", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))" inputmode="decimal" autocomplete="off" />
                    <small class="text-muted">
                        @(isNew ? "Ejemplo: 12 para doce unidades o 2,5 para dos kilos y medio." : "Este valor baja automáticamente cuando se venden productos de este lote.")
                    </small>
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                @if (!isNew)
                {
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="initialQuantityText">Cantidad inicial (@unitLabel)</label>
                            <input id="initialQuantityText"
                                   name="initialQuantityText"
                                   class="form-control"
                                   value="@Model.InitialQuantity.ToString("#,##0.###", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))"
                                   inputmode="decimal"
                                   autocomplete="off" />
                        <small class="text-muted">Sirve para comparar cuánto entró contra cuánto queda.</small>
                        <span asp-validation-for="InitialQuantity" class="text-danger"></span>
                    </div>
                }

                <div class="col-md-6 mb-3">
                    <label asp-for="PurchaseDate" class="form-label">Fecha de compra</label>
                    <input asp-for="PurchaseDate" type="date" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ExpirationDate" class="form-label">Fecha de vencimiento</label>
                    <input asp-for="ExpirationDate" type="date" class="form-control" />
                    <small class="text-muted">Dejalo vacío si el producto no tiene vencimiento.</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label" for="costText">Costo de compra @costSuffix</label>
                    <input id="costText" name="costText" class="form-control" value="@Model.Cost.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))" inputmode="decimal" autocomplete="off" />
                    <small class="text-muted">Se usa para calcular la ganancia real al vender este stock.</small>
                    <span asp-validation-for="Cost" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="form-label">Estado</div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input admin-switch" type="checkbox" role="switch" />
                        <label class="form-check-label fw-bold admin-switch-label" asp-for="IsActive">
                            Activo
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-area="Admin"
                   asp-controller="ArticleBatches"
                   asp-action="Index"
                   asp-route-articleId="@Model.ArticleId"
                   class="btn btn-soft-secondary">
                    <i class="fa fa-arrow-left me-1"></i> Volver
                </a>

                <button type="submit" class="btn btn-primary btn-modern">
                    <i class="fa fa-save me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
