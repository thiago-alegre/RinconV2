@model Rincon.Models.Sale

@{
    ViewData["Title"] = "Detalle de venta";
    var userName = Model.User != null
        ? (!string.IsNullOrWhiteSpace(Model.User.FullName) ? Model.User.FullName : Model.User.Email)
        : "Sin usuario";
    var cashRegisterLabel = Model.CashRegisterSession != null
        ? $"Caja #{Model.CashRegisterSession.Id}"
        : "Sin caja asociada";
    var personalAccountLabel = Model.PersonalAccount != null
        ? Model.PersonalAccount.FullName
        : "-";

    string FormatSaleQuantity(decimal quantity, string unitOfMeasure)
    {
        if (unitOfMeasure == "Kilogramo")
        {
            var formatted = quantity % 1 == 0
                ? quantity.ToString("N0")
                : quantity.ToString("N3").TrimEnd('0').TrimEnd(',');

            return $"{formatted} kg";
        }

        return $"{quantity:N0}";
    }

    (string Text, string ClassName) GetSaleDetailStatus(Rincon.Models.SaleDetail detail)
    {
        return Model.IsVoided
            ? ("Anulado", "status-inactive")
            : ("Vendido", "status-active");
    }
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="fa fa-receipt"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Venta #@Model.Id</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">Detalle de venta</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Detalle de venta",
                        Description = "Esta pantalla muestra toda la información de una venta concreta y permite resolver errores o reclamos.",
                        Items = new[] {
                            "Revisá total, medio de pago, usuario y caja asociada.",
                            "La tabla detalla productos vendidos, cantidades, precios y subtotales.",
                            "Si la venta fue a cuenta personal, también se muestra la cuenta vinculada.",
                            "Anular venta se usa cuando la operación fue cargada por error: se anula la venta completa, se repone el stock y se descuenta el importe de caja o cuenta personal.",
                            "Recambio se usa cuando el cliente reclama un producto fallado: se entrega el mismo producto, se descuenta stock nuevamente y no se suma dinero a caja."
                        }
                    })
                </div>
                <p class="admin-subtitle mb-0">
                    Registrada el @Model.Date.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Sales" asp-action="Index" class="btn btn-soft-secondary">
            <i class="fa fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    @if (Model.IsVoided)
    {
        <div class="alert custom-alert-danger mb-4">
            <i class="fa fa-ban me-2"></i>
            Esta venta fue anulada el @Model.VoidedAt?.ToString("dd/MM/yyyy HH:mm").
            Motivo: @(string.IsNullOrWhiteSpace(Model.VoidReason) ? "Sin motivo informado" : Model.VoidReason)
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Total</div>
                <div class="detail-metric-value success">$ @Model.Total.ToString("N2")</div>
                @if (Model.PaymentMethod == Rincon.Utilities.Enums.PaymentMethod.Combinado)
                {
                    <div class="text-muted small mt-1">
                        Transferencia: $ @Model.TransferAmount.ToString("N2")<br />
                        Efectivo: $ @Model.CashAmount.ToString("N2")
                    </div>
                }
            </div>
        </div>

        <div class="col-md-3">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Medio de pago</div>
                <div class="detail-metric-value">@Model.PaymentMethod</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Usuario</div>
                <div class="detail-metric-value">@userName</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="detail-metric-card">
                <div class="detail-metric-label">Caja</div>
                <div class="detail-metric-value">@cashRegisterLabel</div>
            </div>
        </div>
    </div>

    @if (Model.PaymentMethod == Rincon.Utilities.Enums.PaymentMethod.CuentaPersonal)
    {
        <div class="content-card mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                <div>
                    <span class="section-kicker">Cuenta personal</span>
                    <h2 class="section-title mb-0">@personalAccountLabel</h2>
                </div>
                @if (Model.IsPersonalAccountSettled)
                {
                    <span class="status-badge active">Saldada</span>
                }
                else
                {
                    <span class="status-badge inactive">Pendiente</span>
                }
            </div>
        </div>
    }

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Detalle</span>
                <h2 class="section-title mb-0">Productos vendidos</h2>
            </div>
            @if (!Model.IsVoided && !Model.SaleReturns.Any())
            {
                <button type="button" class="btn btn-soft-danger" data-bs-toggle="modal" data-bs-target="#voidSaleModal">
                    <i class="fa fa-ban me-1"></i> Anular venta
                </button>
            }
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table class="table custom-table mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Código</th>
                        <th>Cantidad</th>
                        <th>Precio unitario</th>
                        <th>Unidad</th>
                        <th class="text-end">Subtotal</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SaleDetails)
                    {
                        var status = GetSaleDetailStatus(item);
                        <tr>
                            <td class="fw-semibold">@item.ArticleName</td>
                            <td>@(string.IsNullOrWhiteSpace(item.ArticleCode) ? "-" : item.ArticleCode)</td>
                            <td>@FormatSaleQuantity(item.Quantity, item.UnitOfMeasure)</td>
                            <td>$ @item.UnitPrice.ToString("N2")</td>
                            <td>@item.UnitOfMeasure</td>
                            <td class="text-end fw-bold">$ @item.Subtotal.ToString("N2")</td>
                            <td><span class="status-badge @status.ClassName">@status.Text</span></td>
                            <td class="text-end">
                                @if (!Model.IsVoided && item.ArticleId.HasValue)
                                {
                                    <button type="button"
                                            class="btn btn-soft-warning btn-modern-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#exchangeSaleModal"
                                            data-sale-detail-id="@item.Id"
                                            data-product="@item.ArticleName"
                                            data-quantity="@FormatSaleQuantity(item.Quantity, item.UnitOfMeasure)">
                                        <i class="fa fa-rotate me-1"></i> Recambio
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.SaleExchanges.Any())
    {
        <div class="content-card mt-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
                <div>
                    <span class="section-kicker">Recambios</span>
                    <h2 class="section-title mb-0">Recambios por falla registrados</h2>
                </div>
            </div>

            <div class="table-responsive custom-table-wrapper">
                <table class="table custom-table mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Producto entregado</th>
                            <th>Cantidad</th>
                            <th>Pérdida estimada</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exchange in Model.SaleExchanges.OrderByDescending(e => e.Date))
                        {
                            <tr>
                                <td>@exchange.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-semibold">@(exchange.ReplacementArticle?.Name ?? "Producto no disponible")</td>
                                <td>@FormatSaleQuantity(exchange.Quantity, exchange.UnitOfMeasure)</td>
                                <td class="fw-bold text-danger">$ @exchange.EstimatedLoss.ToString("N2")</td>
                                <td>@(string.IsNullOrWhiteSpace(exchange.Reason) ? "-" : exchange.Reason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (!Model.IsVoided && !Model.SaleReturns.Any())
{
    <div class="modal fade screen-help-modal" id="voidSaleModal" tabindex="-1" aria-labelledby="voidSaleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content screen-help-content">
                <div class="modal-header screen-help-header">
                    <div>
                        <span class="section-kicker">Anulación</span>
                        <h2 class="modal-title screen-help-title" id="voidSaleModalLabel">Anular venta #@Model.Id</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-area="Admin" asp-controller="Sales" asp-action="Void" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="modal-body screen-help-body">
                        <p class="screen-help-description">
                            La anulación corresponde cuando una venta fue registrada por error. Se anulará la venta completa, se repondrá el stock vendido y el importe se descontará de la caja o de la cuenta personal asociada.
                        </p>

                        <label for="voidReason" class="form-label fw-semibold">Motivo</label>
                        <textarea id="voidReason"
                                  name="reason"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Ej: venta cargada por error"></textarea>
                    </div>
                    <div class="modal-footer screen-help-footer">
                        <button type="button" class="btn btn-soft-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-soft-danger">
                            <i class="fa fa-ban me-1"></i> Sí, anular
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (!Model.IsVoided)
{
    <div class="modal fade screen-help-modal" id="exchangeSaleModal" tabindex="-1" aria-labelledby="exchangeSaleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content screen-help-content">
                <div class="modal-header screen-help-header">
                    <div>
                        <span class="section-kicker">Recambio</span>
                        <h2 class="modal-title screen-help-title" id="exchangeSaleModalLabel">Registrar recambio</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-area="Admin" asp-controller="Sales" asp-action="Exchange" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" id="exchangeSaleDetailId" name="saleDetailId" value="" />

                    <div class="modal-body screen-help-body">
                        <p class="screen-help-description mb-2">
                            Producto reclamado: <strong id="exchangeProductName">-</strong>
                            <span class="d-block text-muted">Cantidad original: <span id="exchangeOriginalQuantity">-</span></span>
                        </p>
                        <p class="small text-muted">
                            El recambio corresponde cuando el cliente trae un producto fallado y se le entrega otro igual.
                            No anula la venta ni suma dinero a caja; descuenta otra unidad o peso del stock y registra
                            la pérdida estimada por la reposición.
                        </p>

                        <div class="mb-3">
                            <label for="exchangeQuantityText" class="form-label fw-semibold">Cantidad entregada</label>
                            <input id="exchangeQuantityText"
                                   name="quantityText"
                                   class="form-control"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   placeholder="Dejar vacío para usar la cantidad original" />
                        </div>

                        <label for="exchangeReason" class="form-label fw-semibold">Motivo</label>
                        <textarea id="exchangeReason"
                                  name="reason"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Ej: producto en mal estado"></textarea>
                    </div>
                    <div class="modal-footer screen-help-footer">
                        <button type="button" class="btn btn-soft-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-soft-warning">
                            <i class="fa fa-rotate me-1"></i> Registrar recambio
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const exchangeModal = document.getElementById('exchangeSaleModal');

            if (!exchangeModal) {
                return;
            }

            exchangeModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('exchangeSaleDetailId').value = button.getAttribute('data-sale-detail-id');
                document.getElementById('exchangeProductName').textContent = button.getAttribute('data-product');
                document.getElementById('exchangeOriginalQuantity').textContent = button.getAttribute('data-quantity');
                document.getElementById('exchangeQuantityText').value = '';
                document.getElementById('exchangeReason').value = '';
            });
        });
    </script>
}
