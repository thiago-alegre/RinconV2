@model Rincon.Models.ViewModels.SalesIndexVM

@{
    ViewData["Title"] = "Historial de ventas";
}

<div class="admin-page py-4">
    <div class="admin-hero mb-4 d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="admin-hero-icon">
                <i class="fa fa-receipt"></i>
            </div>
            <div>
                <span class="admin-eyebrow">Administración</span>
                <div class="d-flex align-items-center gap-2">
                    <h1 class="admin-title h3 mb-1">Historial de ventas</h1>
                    @await Html.PartialAsync("~/Views/Shared/_ScreenHelp.cshtml", new Rincon.Models.ViewModels.ScreenHelpVM
                    {
                        Title = "Cómo usar ventas",
                        Description = "Consultá las ventas registradas, quién las hizo y el detalle de cada operación.",
        Items = new[]
        {
            "Filtrá por usuario y fecha para revisar un turno o un día puntual.",
            "Usá Ver detalle para consultar productos vendidos, cantidades y total.",
            "Eliminar filtros vuelve a mostrar el historial completo."
        }
                    })
                </div>
                <p class="admin-subtitle mb-0">Consultá las ventas realizadas y el usuario que las registró.</p>
            </div>
        </div>

        <div class="sales-hero-filters">
            <div class="sales-filter-field">
                <label for="saleUserFilter">Usuario</label>
                <select id="saleUserFilter" class="form-select">
                    <option value="">Todos los usuarios</option>
                    @foreach (var user in Model.UserList)
                    {
                        <option value="@user.Value" selected="@(Model.UserId == user.Value ? "selected" : null)">
                            @user.Text
                        </option>
                    }
                </select>
            </div>

            <div class="sales-filter-field">
                <label for="saleDateFilter">Fecha</label>
                <input id="saleDateFilter"
                       type="date"
                       class="form-control"
                       value="@(Model.SaleDate.HasValue ? Model.SaleDate.Value.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>

            <button id="clearSalesFilters" type="button" class="btn btn-soft-secondary">
                <i class="fa fa-rotate-left me-1"></i> Eliminar filtros
            </button>
        </div>
    </div>

    <div class="content-card">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <span class="section-kicker">Listado</span>
                <h2 class="section-title mb-0">Ventas registradas</h2>
            </div>
        </div>

        <div class="table-responsive custom-table-wrapper">
            <table id="salesTable" class="table custom-table mb-0 w-100">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Medio de pago</th>
                        <th>Total</th>
                        <th>Usuario</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sale.js" asp-append-version="true"></script>
}
